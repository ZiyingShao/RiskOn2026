{"name": "jewelry_vault_optimization", "tables": [{"name": "inv", "path": "diamonds.csv", "sample": {"n": 800, "seed": 7}, "derived": [{"name": "volume", "expr": "x * y * z"}]}], "sets": [{"name": "stones", "kind": "rows", "table": "inv"}, {"name": "cuts", "kind": "categories", "table": "inv", "column": "cut"}, {"name": "clarity_grades", "kind": "categories", "table": "inv", "column": "clarity"}], "params": [{"name": "carat", "index": ["stones"], "table": "inv", "column": "carat"}, {"name": "price", "index": ["stones"], "table": "inv", "column": "price"}, {"name": "volume", "index": ["stones"], "table": "inv", "column": "volume"}], "vars": [{"name": "x", "index": ["stones"], "domain": "Binary"}], "objective": {"sense": "max", "expr": {"terms": [{"var": "x", "weight": "carat", "over": {"set": "stones"}}], "const": 0}, "source_text": "The goal is to maximise the total carat mass held in the vault."}, "constraints": [{"name": "budget", "lhs": {"terms": [{"var": "x", "weight": "price", "over": {"set": "stones"}}], "const": 0}, "rel": "<=", "rhs": {"terms": [], "const": 250000}, "source_text": "the total wholesale price of the stones bought must not exceed it"}, {"name": "max_slots", "lhs": {"terms": [{"var": "x", "over": {"set": "stones"}}], "const": 0}, "rel": "<=", "rhs": {"terms": [], "const": 60}, "source_text": "at most 60 stones can be held"}, {"name": "max_volume", "lhs": {"terms": [{"var": "x", "weight": "volume", "over": {"set": "stones"}}], "const": 0}, "rel": "<=", "rhs": {"terms": [], "const": 9000}, "source_text": "Total displayed stone volume cannot exceed 9,000 cubic millimetres"}, {"name": "cut_grade_30pct", "forall": ["cuts"], "lhs": {"terms": [{"var": "x", "over": {"set": "stones", "where": [{"column": "cut", "op": "eq", "value": "$cuts"}]}}, {"coef": -0.3, "var": "x", "over": {"set": "stones"}}], "const": 0}, "rel": "<=", "rhs": {"terms": [], "const": 0}, "source_text": "No single cut grade may exceed 30% of the stones held."}, {"name": "clarity_minimum", "forall": ["clarity_grades"], "lhs": {"terms": [{"var": "x", "over": {"set": "stones", "where": [{"column": "clarity", "op": "eq", "value": "$clarity_grades"}]}}], "const": 0}, "rel": ">=", "rhs": {"terms": [], "const": 2}, "source_text": "Carry at least two stones of every clarity grade so the range stays saleable."}, {"name": "expensive_capital", "lhs": {"terms": [{"var": "x", "weight": "price", "over": {"set": "stones", "where": [{"column": "price", "op": "gt", "value": 8000}]}}, {"coef": -0.4, "var": "x", "weight": "price", "over": {"set": "stones"}}], "const": 0}, "rel": "<=", "rhs": {"terms": [], "const": 0}, "source_text": "At most 40% of deployed capital may sit in stones priced above CHF 8,000."}, {"name": "cut_grade_20pct", "forall": ["cuts"], "lhs": {"terms": [{"var": "x", "over": {"set": "stones", "where": [{"column": "cut", "op": "eq", "value": "$cuts"}]}}, {"coef": -0.2, "var": "x", "over": {"set": "stones"}}], "const": 0}, "rel": "<=", "rhs": {"terms": [], "const": 0}, "source_text": "keep every cut grade to at most 20% of the stones held"}]}
