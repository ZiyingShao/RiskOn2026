   "kind": "rows",
   "table": "inv"
  },
  {
   "name": "cut_grades",
   "kind": "categories",
   "table": "inv",
   "column": "cut"
  },
  {
   "name": "clarity_grades",
   "kind": "categories",
   "table": "inv",
   "column": "clarity"
  }
 ],
 "params": [
  {
   "name": "carat",
   "index": [
    "rows"
   ],
   "table": "inv",
   "column": "carat"
  },
  {
   "name": "price",
   "index": [
    "rows"
   ],
   "table": "inv",
   "column": "price"
  },
  {
   "name": "volume",
   "index": [
    "rows"
   ],
   "table": "inv",
   "column": "volume"
  }
 ],
 "vars": [
  {
   "name": "x",
   "index": [
    "rows"
   ],
   "domain": "Binary"
  }
 ],
 "objective": {
  "sense": "max",
  "expr": {
   "terms": [
    {
     "var": "x",
     "over": {
      "set": "rows"
     },
     "weight": "carat"
    }
   ],
   "const": 0
  },
  "source_text": "The goal is to maximise the total carat mass held in the vault."
 },
 "constraints": [
  {
   "name": "budget_constraint",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "rows"
      },
      "weight": "price"
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 400000
   },
   "source_text": "The bank has extended a CHF 400,000 facility; the total wholesale price of the stones bought must stay within the facility."
  },
  {
   "name": "display_slots",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "rows"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 60
   },
   "source_text": "The retail vault has 60 individual display slots, so at most 60 stones can be held."
  },
  {
   "name": "volume_limit",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "rows"
      },
      "weight": "volume"
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 9000
   },
   "source_text": "Total displayed stone volume cannot exceed 9,000 cubic millimetres; a stone's volume is x times y times z."
  },
  {
   "name": "cut_grade_pct_limit",
   "forall": [
    "cut_grades"
   ],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "rows",
       "where": [
        {
         "column": "cut",
         "op": "eq",
         "value": "$cut_grades"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 0.3,
      "var": "x",
      "over": {
       "set": "rows"
      }
     }
    ],
    "const": 0
   },
   "source_text": "No single cut grade may exceed 30% of the stones held."
  },
  {
   "name": "clarity_grade_minimum",
   "forall": [
    "clarity_grades"
   ],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "rows",
       "where": [
        {
         "column": "clarity",
         "op": "eq",
         "value": "$clarity_grades"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": ">=",
   "rhs": {
    "terms": [],
    "const": 2
   },
   "source_text": "Carry at least two stones of every clarity grade so the range stays saleable."
  },
  {
   "name": "high_price_capital_limit",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "rows",
       "where": [
        {
         "column": "price",
         "op": "gt",
         "value": 8000
        }
       ]
      },
      "weight": "price"
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 0.4,
      "var": "x",
      "over": {
       "set": "rows"
      },
      "weight": "price"
     }
    ],
    "const": 0
   },
   "source_text": "At most 40% of deployed capital may sit in stones priced above CHF 8,000."
  }
 ]
}