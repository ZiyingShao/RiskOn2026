{
 "name": "diamond_vault_optimization",
 "tables": [
  {
   "name": "inv",
   "path": "diamonds.csv",
   "sample": {
    "n": 800,
    "seed": 7
   },
   "derived": []
  }
 ],
 "sets": [
  {
   "name": "stones",
   "kind": "rows",
   "table": "inv"
  },
  {
   "name": "cuts",
   "kind": "categories",
   "table": "inv",
   "column": "cut"
  },
  {
   "name": "clarities",
   "kind": "categories",
   "table": "inv",
   "column": "clarity"
  }
 ],
 "params": [
  {
   "name": "price",
   "index": [
    "stones"
   ],
   "table": "inv",
   "column": "price"
  },
  {
   "name": "carat",
   "index": [
    "stones"
   ],
   "table": "inv",
   "column": "carat"
  }
 ],
 "vars": [
  {
   "name": "x",
   "index": [
    "stones"
   ],
   "domain": "Binary"
  }
 ],
 "objective": {
  "sense": "max",
  "expr": {
   "terms": [
    {
     "weight": "carat",
     "var": "x",
     "over": {
      "set": "stones"
     }
    }
   ],
   "const": 0
  },
  "source_text": "The goal is to maximise the total carat mass held in the vault."
 },
 "constraints": [
  {
   "name": "budget",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "weight": "price",
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 250000
   },
   "source_text": "Deploy a fixed line of credit of CHF 250,000: the total wholesale price of the stones bought must not exceed it."
  },
  {
   "name": "max_stones",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 60
   },
   "source_text": "The retail vault has 60 individual display slots, so at most 60 stones can be held."
  },
  {
   "name": "max_per_cut",
   "forall": [
    "cuts"
   ],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "stones",
       "where": [
        {
         "column": "cut",
         "op": "eq",
         "value": "$cuts"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 0.3,
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "source_text": "No single cut grade may exceed 30% of the stones held."
  },
  {
   "name": "min_per_clarity",
   "forall": [
    "clarities"
   ],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "stones",
       "where": [
        {
         "column": "clarity",
         "op": "eq",
         "value": "$clarities"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": ">=",
   "rhs": {
    "terms": [],
    "const": 2
   },
   "source_text": "Carry at least two stones of every clarity grade so the range stays saleable."
  },
  {
   "name": "max_high_price_share",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "weight": "price",
      "var": "x",
      "over": {
       "set": "stones",
       "where": [
        {
         "column": "price",
         "op": "gt",
         "value": 8000
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 0.4,
      "weight": "price",
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "source_text": "At most 40% of deployed capital may sit in stones priced above CHF 8,000."
  }
 ]
}