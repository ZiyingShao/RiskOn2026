  },
  {
   "name": "slots",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "coef": 1,
      "var": "x",
      "over": {
       "set": "rows"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 60
     }
    ],
    "const": 0
   },
   "source_text": "at most 60 stones can be held"
  },
  {
   "name": "volume",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "coef": 1,
      "weight": "volume",
      "var": "x",
      "over": {
       "set": "rows"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 9000
     }
    ],
    "const": 0
   },
   "source_text": "Total displayed stone volume cannot exceed 9,000 cubic millimetres"
  },
  {
   "name": "cut_fraction",
   "forall": [
    "cuts"
   ],
   "lhs": {
    "terms": [
     {
      "coef": 1,
      "var": "x",
      "over": {
       "set": "rows",
       "where": [
        {
         "column": "cut",
         "op": "eq",
         "value": "$cuts"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 0.25,
      "var": "x",
      "over": {
       "set": "rows"
      }
     }
    ],
    "const": 0
   },
   "source_text": "No single cut grade may exceed 25% of the stones held"
  },
  {
   "name": "clarity_minimum",
   "forall": [
    "clarities"
   ],
   "lhs": {
    "terms": [
     {
      "coef": 1,
      "var": "x",
      "over": {
       "set": "rows",
       "where": [
        {
         "column": "clarity",
         "op": "eq",
         "value": "$clarities"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": ">=",
   "rhs": {
    "terms": [
     {
      "coef": 2
     }
    ],
    "const": 0
   },
   "source_text": "Carry at least two stones of every clarity grade"
  },
  {
   "name": "price_cap",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "coef": 1,
      "weight": "price",
      "var": "x",
      "over": {
       "set": "rows",
       "where": [
        {
         "column": "price",
         "op": "gt",
         "value": 8000
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 0.4,
      "weight": "price",
      "var": "x",
      "over": {
       "set": "rows"
      }
     }
    ],
    "const": 0
   },
