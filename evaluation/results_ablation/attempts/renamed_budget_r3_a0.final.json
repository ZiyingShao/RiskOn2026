{
 "name": "zurich_jeweler_vault_stocking",
 "tables": [
  {
   "name": "inv",
   "path": "diamonds.csv",
   "sample": {
    "n": 800,
    "seed": 7
   },
   "derived": [
    {
     "name": "volume",
     "expr": "x * y * z"
    }
   ]
  }
 ],
 "sets": [
  {
   "name": "stones",
   "kind": "rows",
   "table": "inv"
  },
  {
   "name": "cuts",
   "kind": "categories",
   "table": "inv",
   "column": "cut"
  },
  {
   "name": "clarities",
   "kind": "categories",
   "table": "inv",
   "column": "clarity"
  }
 ],
 "params": [
  {
   "name": "stone_price",
   "index": [
    "stones"
   ],
   "table": "inv",
   "column": "price"
  },
  {
   "name": "stone_carat",
   "index": [
    "stones"
   ],
   "table": "inv",
   "column": "carat"
  },
  {
   "name": "stone_volume",
   "index": [
    "stones"
   ],
   "table": "inv",
   "column": "volume"
  }
 ],
 "vars": [
  {
   "name": "x",
   "index": [
    "stones"
   ],
   "domain": "Binary"
  }
 ],
 "constraints": [
  {
   "name": "budget_constraint",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "weight": "stone_price",
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 400000
   },
   "source_text": "the total wholesale price of the stones bought must stay within the facility"
  },
  {
   "name": "slot_constraint",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 60
   },
   "source_text": "at most 60 stones can be held"
  },
  {
   "name": "volume_constraint",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "weight": "stone_volume",
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 9000
   },
   "source_text": "Total displayed stone volume cannot exceed 9,000 cubic millimetres"
  },
  {
   "name": "cut_max_constraint",
   "forall": [
    "cuts"
   ],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "stones",
       "where": [
        {
         "column": "cut",
         "op": "eq",
         "value": "$cuts"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 0.3,
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "source_text": "No single cut grade may exceed 30% of the stones held"
  },
  {
   "name": "clarity_min_constraint",
   "forall": [
    "clarities"
   ],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "stones",
       "where": [
        {
         "column": "clarity",
         "op": "eq",
         "value": "$clarities"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": ">=",
   "rhs": {
    "terms": [],
    "const": 2
   },
   "source_text": "Carry at least two stones of every clarity grade so the range stays saleable"
  },
  {
   "name": "high_price_capital_constraint",
   "forall": [],
   "lhs": {
    "terms": [
     {
      "weight": "stone_price",
      "var": "x",
      "over": {
       "set": "stones",
       "where": [
        {
         "column": "price",
         "op": "gt",
         "value": 8000
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 0.4,
      "weight": "stone_price",
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "source_text": "At most 40% of deployed capital may sit in stones priced above CHF 8,000"
  }
 ],
 "objective": {
  "sense": "max",
  "expr": {
   "terms": [
    {
     "weight": "stone_carat",
     "var": "x",
     "over": {
      "set": "stones"
     }
    }
   ],
   "const": 0
  },
  "source_text": "The goal is to maximise the total carat mass held in the vault"
 }
}