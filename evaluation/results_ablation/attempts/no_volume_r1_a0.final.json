{
 "name": "diamond_vault",
 "tables": [
  {
   "name": "inv",
   "path": "diamonds.csv",
   "sample": {
    "n": 800,
    "seed": 7
   }
  }
 ],
 "sets": [
  {
   "name": "stones",
   "kind": "rows",
   "table": "inv"
  },
  {
   "name": "cuts",
   "kind": "categories",
   "table": "inv",
   "column": "cut"
  },
  {
   "name": "clarities",
   "kind": "categories",
   "table": "inv",
   "column": "clarity"
  }
 ],
 "params": [
  {
   "name": "price",
   "index": [
    "stones"
   ],
   "table": "inv",
   "column": "price"
  },
  {
   "name": "carat",
   "index": [
    "stones"
   ],
   "table": "inv",
   "column": "carat"
  }
 ],
 "vars": [
  {
   "name": "x",
   "index": [
    "stones"
   ],
   "domain": "Binary"
  }
 ],
 "constraints": [
  {
   "name": "budget_constraint",
   "lhs": {
    "terms": [
     {
      "weight": "price",
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 250000
   },
   "source_text": "the total wholesale price of the stones bought must not exceed it"
  },
  {
   "name": "display_slots_constraint",
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 60
   },
   "source_text": "at most 60 stones can be held"
  },
  {
   "name": "cut_grade_limit",
   "forall": [
    "cuts"
   ],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "stones",
       "where": [
        {
         "column": "cut",
         "op": "eq",
         "value": "$cuts"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [
     {
      "coef": 0.3,
      "var": "x",
      "over": {
       "set": "stones"
      }
     }
    ],
    "const": 0
   },
   "source_text": "No single cut grade may exceed 30% of the stones held"
  },
  {
   "name": "minimum_clarity_stones",
   "forall": [
    "clarities"
   ],
   "lhs": {
    "terms": [
     {
      "var": "x",
      "over": {
       "set": "stones",
       "where": [
        {
         "column": "clarity",
         "op": "eq",
         "value": "$clarities"
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": ">=",
   "rhs": {
    "terms": [],
    "const": 2
   },
   "source_text": "Carry at least two stones of every clarity grade"
  },
  {
   "name": "expensive_stones_limit",
   "lhs": {
    "terms": [
     {
      "weight": "price",
      "var": "x",
      "over": {
       "set": "stones",
       "where": [
        {
         "column": "price",
         "op": "gt",
         "value": 8000
        }
       ]
      }
     }
    ],
    "const": 0
   },
   "rel": "<=",
   "rhs": {
    "terms": [],
    "const": 100000
   },
   "source_text": "At most 40% of deployed capital may sit in stones priced above CHF 8,000"
  }
 ],
 "objective": {
  "sense": "max",
  "expr": {
   "terms": [
    {
     "weight": "carat",
     "var": "x",
     "over": {
      "set": "stones"
     }
    }
   ],
   "const": 0
  },
  "source_text": "The goal is to maximise the total carat mass held in the vault"
 }
}