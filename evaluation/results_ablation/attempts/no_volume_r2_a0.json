{"name": "Zurich Jeweler Vault Optimization", "tables": [{"name": "inv", "path": "diamonds.csv", "sample": {"n": 800, "seed": 7}, "derived": []}], "sets": [{"name": "stones", "kind": "rows", "table": "inv"}, {"name": "cuts", "kind": "categories", "table": "inv", "column": "cut"}, {"name": "clarities", "kind": "categories", "table": "inv", "column": "clarity"}], "params": [{"name": "price", "index": ["stones"], "table": "inv", "column": "price"}, {"name": "carat", "index": ["stones"], "table": "inv", "column": "carat"}, {"name": "credit_limit", "value": 250000}, {"name": "vault_capacity", "value": 60}, {"name": "cut_fraction_limit", "value": 0.3}, {"name": "min_clarity_stones", "value": 2}, {"name": "high_price_threshold", "value": 8000}, {"name": "high_price_fraction_limit", "value": 0.4}], "vars": [{"name": "x", "index": ["stones"], "domain": "Binary"}], "objective": {"sense": "max", "expr": {"terms": [{"weight": "carat", "var": "x", "over": {"set": "stones"}}], "const": 0}, "source_text": "The goal is to maximise the total carat mass held in the vault."}, "constraints": [{"name": "credit_limit", "forall": [], "lhs": {"terms": [{"weight": "price", "var": "x", "over": {"set": "stones"}}], "const": 0}, "rel": "<=", "rhs": {"terms": [], "const": 250000}, "source_text": "Deploy a fixed line of credit of CHF 250,000: the total wholesale price of the stones bought must not exceed it."}, {"name": "vault_capacity", "forall": [], "lhs": {"terms": [{"var": "x", "over": {"set": "stones"}}], "const": 0}, "rel": "<=", "rhs": {"terms": [], "const": 60}, "source_text": "The retail vault has 60 individual display slots, so at most 60 stones can be held."}, {"name": "cut_grade_limit", "forall": ["cuts"], "lhs": {"terms": [{"var": "x", "over": {"set": "stones", "where": [{"column": "cut", "op": "eq", "value": "$cuts"}]}}], "const": 0}, "rel": "<=", "rhs": {"terms": [{"coef": 0.3, "var": "x", "over": {"set": "stones"}}], "const": 0}, "source_text": "No single cut grade may exceed 30% of the stones held."}, {"name": "clarity_grade_minimum", "forall": ["clarities"], "lhs": {"terms": [{"var": "x", "over": {"set": "stones", "where": [{"column": "clarity", "op": "eq", "value": "$clarities"}]}}], "const": 0}, "rel": ">=", "rhs": {"terms": [], "const": 2}, "source_text": "Carry at least two stones of every clarity grade so the range stays saleable."}, {"name": "high_price_capital_limit", "forall": [], "lhs": {"terms": [{"weight": "price", "var": "x", "over": {"set": "stones", "where": [{"column": "price", "op": "gt", "value": 8000}]}}], "const": 0}, "rel": "<=", "rhs": {"terms": [{"coef": 0.4, "weight": "price", "var": "x", "over": {"set": "stones"}}], "const": 0}, "source_text": "At most 40% of deployed capital may sit in stones priced above CHF 8,000."}]}