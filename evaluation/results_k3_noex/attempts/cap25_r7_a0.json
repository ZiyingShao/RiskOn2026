{
  "name": "zurich_retail_vault_stocking",
  "tables": [
    {
      "name": "inv",
      "path": "diamonds.csv",
      "sample": {
        "n": 800,
        "seed": 7
      },
      "derived": [
        {
          "name": "volume",
          "expr": "x * y * z"
        }
      ]
    }
  ],
  "sets": [
    {
      "name": "I",
      "kind": "rows",
      "table": "inv"
    },
    {
      "name": "Cuts",
      "kind": "categories",
      "table": "inv",
      "column": "cut"
    },
    {
      "name": "Clarities",
      "kind": "categories",
      "table": "inv",
      "column": "clarity"
    }
  ],
  "params": [
    {
      "name": "carat",
      "index": [
        "I"
      ],
      "table": "inv",
      "column": "carat"
    },
    {
      "name": "price",
      "index": [
        "I"
      ],
      "table": "inv",
      "column": "price"
    },
    {
      "name": "volume",
      "index": [
        "I"
      ],
      "table": "inv",
      "column": "volume"
    }
  ],
  "vars": [
    {
      "name": "x",
      "index": [
        "I"
      ],
      "domain": "Binary"
    }
  ],
  "objective": {
    "sense": "max",
    "expr": {
      "terms": [
        {
          "coef": 1.0,
          "var": "x",
          "weight": "carat",
          "over": {
            "set": "I"
          }
        }
      ],
      "const": 0.0
    },
    "source_text": "The goal is to maximise the total carat mass held in the vault."
  },
  "constraints": [
    {
      "name": "credit_line_limit",
      "forall": [],
      "lhs": {
        "terms": [
          {
            "coef": 1.0,
            "var": "x",
            "weight": "price",
            "over": {
              "set": "I"
            }
          }
        ],
        "const": 0.0
      },
      "rel": "<=",
      "rhs": {
        "terms": [],
        "const": 250000.0
      },
      "source_text": "Deploy a fixed line of credit of CHF 250,000: the total wholesale price of the stones bought must not exceed it."
    },
    {
      "name": "display_slot_limit",
      "forall": [],
      "lhs": {
        "terms": [
          {
            "coef": 1.0,
            "var": "x",
            "over": {
              "set": "I"
            }
          }
        ],
        "const": 0.0
      },
      "rel": "<=",
      "rhs": {
        "terms": [],
        "const": 60.0
      },
      "source_text": "The retail vault has 60 individual display slots, so at most 60 stones can be held."
    },
    {
      "name": "displayed_volume_limit",
      "forall": [],
      "lhs": {
        "terms": [
          {
            "coef": 1.0,
            "var": "x",
            "weight": "volume",
            "over": {
              "set": "I"
            }
          }
        ],
        "const": 0.0
      },
      "rel": "<=",
      "rhs": {
        "terms": [],
        "const": 9000.0
      },
      "source_text": "Total displayed stone volume cannot exceed 9,000 cubic millimetres; a stone's volume is x times y times z."
    },
    {
      "name": "cut_grade_share_limit",
      "forall": [
        "Cuts"
      ],
      "lhs": {
        "terms": [
          {
            "coef": 1.0,
            "var": "x",
            "over": {
              "set": "I",
              "where": [
                {
                  "column": "cut",
                  "op": "eq",
                  "value": "$Cuts"
                }
              ]
            }
          }
        ],
        "const": 0.0
      },
      "rel": "<=",
      "rhs": {
        "terms": [
          {
            "coef": 0.25,
            "var": "x",
            "over": {
              "set": "I"
            }
          }
        ],
        "const": 0.0
      },
      "source_text": "No single cut grade may exceed 25% of the stones held."
    },
    {
      "name": "minimum_two_per_clarity",
      "forall": [
        "Clarities"
      ],
      "lhs": {
        "terms": [
          {
            "coef": 1.0,
            "var": "x",
            "over": {
              "set": "I",
              "where": [
                {
                  "column": "clarity",
                  "op": "eq",
                  "value": "$Clarities"
                }
              ]
            }
          }
        ],
        "const": 0.0
      },
      "rel": ">=",
      "rhs": {
        "terms": [],
        "const": 2.0
      },
      "source_text": "Carry at least two stones of every clarity grade so the range stays saleable."
    },
    {
      "name": "high_price_capital_share_limit",
      "forall": [],
      "lhs": {
        "terms": [
          {
            "coef": 1.0,
            "var": "x",
            "weight": "price",
            "over": {
              "set": "I",
              "where": [
                {
                  "column": "price",
                  "op": "gt",
                  "value": 8000.0
                }
              ]
            }
          }
        ],
        "const": 0.0
      },
      "rel": "<=",
      "rhs": {
        "terms": [
          {
            "coef": 0.4,
            "var": "x",
            "weight": "price",
            "over": {
              "set": "I"
            }
          }
        ],
        "const": 0.0
      },
      "source_text": "At most 40% of deployed capital may sit in stones priced above CHF 8,000."
    }
  ]
}