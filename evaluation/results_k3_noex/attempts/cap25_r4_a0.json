{
  "name": "zurich_vault_stocking",
  "tables": [
    {
      "name": "inv",
      "path": "diamonds.csv",
      "sample": {"n": 800, "seed": 7},
      "derived": [
        {"name": "vol", "expr": "x * y * z"}
      ]
    }
  ],
  "sets": [
    {"name": "Rows", "kind": "rows", "table": "inv"},
    {"name": "Cuts", "kind": "categories", "table": "inv", "column": "cut"},
    {"name": "Clarities", "kind": "categories", "table": "inv", "column": "clarity"}
  ],
  "params": [
    {"name": "price", "index": ["Rows"], "table": "inv", "column": "price"},
    {"name": "carat", "index": ["Rows"], "table": "inv", "column": "carat"},
    {"name": "vol", "index": ["Rows"], "table": "inv", "column": "vol"},
    {"name": "credit_line", "index": [], "value": 250000},
    {"name": "slots", "index": [], "value": 60},
    {"name": "max_volume", "index": [], "value": 9000}
  ],
  "vars": [
    {"name": "x", "index": ["Rows"], "domain": "Binary"}
  ],
  "objective": {
    "sense": "max",
    "expr": {
      "terms": [
        {"coef": 1, "var": "x", "weight": "carat", "over": {"set": "Rows", "where": []}}
      ],
      "const": 0
    },
    "source_text": "The goal is to maximise the total carat mass held in the vault."
  },
  "constraints": [
    {
      "name": "budget",
      "forall": [],
      "lhs": {
        "terms": [
          {"coef": 1, "var": "x", "weight": "price", "over": {"set": "Rows", "where": []}}
        ],
        "const": 0
      },
      "rel": "<=",
      "rhs": {"terms": [], "const": 250000},
      "source_text": "Deploy a fixed line of credit of CHF 250,000: the total wholesale price of the stones bought must not exceed it."
    },
    {
      "name": "display_slots",
      "forall": [],
      "lhs": {
        "terms": [
          {"coef": 1, "var": "x", "over": {"set": "Rows", "where": []}}
        ],
        "const": 0
      },
      "rel": "<=",
      "rhs": {"terms": [], "const": 60},
      "source_text": "The retail vault has 60 individual display slots, so at most 60 stones can be held."
    },
    {
      "name": "volume_limit",
      "forall": [],
      "lhs": {
        "terms": [
          {"coef": 1, "var": "x", "weight": "vol", "over": {"set": "Rows", "where": []}}
        ],
        "const": 0
      },
      "rel": "<=",
      "rhs": {"terms": [], "const": 9000},
      "source_text": "Total displayed stone volume cannot exceed 9,000 cubic millimetres; a stone's volume is x times y times z."
    },
    {
      "name": "cut_share_cap",
      "forall": ["Cuts"],
      "lhs": {
        "terms": [
          {"coef": 1, "var": "x", "over": {"set": "Rows", "where": [{"column": "cut", "op": "eq", "value": "$Cuts"}]}}
        ],
        "const": 0
      },
      "rel": "<=",
      "rhs": {
        "terms": [
          {"coef": 0.25, "var": "x", "over": {"set": "Rows", "where": []}}
        ],
        "const": 0
      },
      "source_text": "No single cut grade may exceed 25% of the stones held."
    },
    {
      "name": "clarity_minimum",
      "forall": ["Clarities"],
      "lhs": {
        "terms": [
          {"coef": 1, "var": "x", "over": {"set": "Rows", "where": [{"column": "clarity", "op": "eq", "value": "$Clarities"}]}}
        ],
        "const": 0
      },
      "rel": ">=",
      "rhs": {"terms": [], "const": 2},
      "source_text": "Carry at least two stones of every clarity grade so the range stays saleable."
    },
    {
      "name": "capital_concentration",
      "forall": [],
      "lhs": {
        "terms": [
          {"coef": 1, "var": "x", "weight": "price", "over": {"set": "Rows", "where": [{"column": "price", "op": "gt", "value": 8000}]}}
        ],
        "const": 0
      },
      "rel": "<=",
      "rhs": {
        "terms": [
          {"coef": 0.4, "var": "x", "weight": "price", "over": {"set": "Rows", "where": []}}
        ],
        "const": 0
      },
      "source_text": "At most 40% of deployed capital may sit in stones priced above CHF 8,000."
    }
  ]
}